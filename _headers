/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=3600

/*.css
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
